# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ai33.pro (OpenSpeaker) — voice (TTS), image generation, music.
# Auth is sent as the header  xi-api-key: <AI33PRO_API_KEY>  (NOT Authorization: Bearer).
# Full API reference: docs/ai33pro-api.md
AI33PRO_API_KEY=your_ai33pro_key_here
AI33PRO_BASE_URL=https://api.ai33.pro

# Google Gemini — script/research + structured video-spec generation
GEMINI_API_KEY=your_gemini_key_here

# Map engine. MapLibre needs no token (free). Mapbox needs a token.
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here   # only required if MAP_ENGINE=mapbox
MAP_ENGINE=maplibre                          # "maplibre" (free) or "mapbox"
