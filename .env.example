# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is gitignored. Only the three REQUIRED values below are needed to run
# `npm run make`. Everything else has sensible defaults.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# 1) ai33.pro (OpenSpeaker) — voice (TTS) + image generation + music.
#    Get it from your ai33.pro dashboard. Auth is the header `xi-api-key`.
#    API reference: docs/ai33pro-api.md
AI33PRO_API_KEY=your_ai33pro_key_here

# 2) Google Gemini — writes the script + structured video spec.
#    Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# 3) The narration voice id (provider prefix REQUIRED). Pick ONE:
#      clone_<id>        a voice you cloned  ->  npm run clone -- sample.mp3 "Name"
#      elevenlabs_<id>   premium/natural
#      edge_en-US-GuyNeural   cheap Microsoft voice (good for testing)
#    List voices: see docs/ai33pro-api.md (GET /v3/voices).
VOICE_ID=edge_en-US-GuyNeural

# ─── OPTIONAL (defaults shown) ───────────────────────────────────────────────

AI33PRO_BASE_URL=https://api.ai33.pro
GEMINI_MODEL=gemini-2.5-flash
VOICE_SPEED=1                 # 0.5–1.5

# Sprite generation (ai33.pro image gen / Seedream)
IMAGE_MODEL=bytedance-seedream-4.5
IMAGE_ASPECT=1:1              # 16:9 | 4:3 | 1:1 | 3:4 | 9:16
IMAGE_RESOLUTION=2K           # 2K | 4K
SPRITE=ship                   # which built-in sprite `make` uses (ship/army/flag/arrow/city)

# Map: "local-countries" (offline bundled basemap, default) or a style URL.
# Mapbox is optional and only needed if you switch to tile styles.
# MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
# MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
