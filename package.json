{
  "name": "shorts-beta",
  "version": "0.1.0",
  "description": "Automated map-driven geography/history YouTube Shorts pipeline",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Short out/example.mp4",
    "render:preview": "remotion render Short out/preview.mp4 --scale=0.5",
    "build": "remotion bundle",
    "typecheck": "tsc --noEmit",
    "voice": "tsx pipeline/voice.ts",
    "clone": "tsx pipeline/voice-clone.ts",
    "sprite": "tsx pipeline/image.ts",
    "script": "tsx pipeline/script.ts",
    "make": "tsx pipeline/make.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.200",
    "@turf/turf": "^7.1.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.200",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
